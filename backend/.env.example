# Copiar este archivo como .env y ajustar los valores.
# El .env real no se sube al repositorio.

PORT=3000

PGHOST=localhost
PGPORT=5434
PGDATABASE=asistencias
PGUSER=postgres
PGPASSWORD=cambiar_por_la_clave_local

# Origen del frontend autorizado a consumir la API
CORS_ORIGIN=http://localhost:4200
